# Copy to .env for local development (never commit .env). src/platform/env.ts validates every one
# of these with Zod at process startup and exits if anything required is missing — no defaults stand
# in for missing configuration (.claude/rules/best-practices.md: "Configuration fails fast").

NODE_ENV=development

# postgres (PostGIS + pgvector). Local dev points at the `postgres` service in the dev Compose override.
DATABASE_URL=postgres://uplan:uplan@localhost:5432/uplan

# Better Auth (accounts-roles.md)
BETTER_AUTH_SECRET=change-me-to-something-random-and-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
CITY_OIDC_ISSUER=
CITY_OIDC_DOMAIN=sammamish.us
CITY_OIDC_CLIENT_ID=
CITY_OIDC_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object storage — OCI's S3-compatibility endpoint (system-architecture.md's O1). Local development
# uses the two development buckets, never production's.
OCI_S3_ENDPOINT=
OCI_S3_REGION=us-phoenix-1
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
OCI_BUCKET_OBJECTS=uplan-dev-objects
OCI_BUCKET_REPORTS=uplan-dev-reports

LOG_LEVEL=info
