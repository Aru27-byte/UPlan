# dependencies
node_modules/

# build output — never committed (do-not.md)
.next/
dist/
out/

# env — secrets never in the repository (do-not.md)
.env
.env.local
.env.*.local

# test / build artifacts — never committed (do-not.md)
coverage/
test-results/
playwright-report/
blob-report/
*.tsbuildinfo

# local model files (later, with F2) — pinned by SHA-256 in deploy/setup.sh, not committed
deploy/models/*.gguf

# The VM's basemap extract, served by deploy/Caddyfile — never committed. public/basemap/*.pmtiles
# is committed on purpose: Vercel serves it as a static file, and a Git deploy ships only what Git holds.
deploy/basemap/*.pmtiles

# copied from node_modules/maplibre-gl/dist by scripts/copy-maplibre-worker.mjs (npm postinstall) —
# always regenerated to match the installed maplibre-gl version, never hand-edited or committed
public/maplibre/

# editor / OS
.DS_Store
*.log
