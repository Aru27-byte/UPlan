{
  "name": "uplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:build": "esbuild src/worker/main.ts --bundle --platform=node --format=esm --outfile=dist/worker/main.js --packages=external",
    "worker:start": "node --env-file=.env dist/worker/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:local": "tsx --env-file=.env scripts/seed-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@better-auth/sso": "^1.7.0",
    "@protomaps/basemaps": "^5.7.2",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.0",
    "graphile-worker": "^0.18.0",
    "maplibre-gl": "^6.0.0",
    "next": "^16.0.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "playwright": "^1.63.0",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.5.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.0.0",
    "terra-draw": "^1.0.0",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "write-excel-file": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testcontainers/postgresql": "^12.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import-x": "^4.0.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
